# Core
SECRET_KEY=change-this-to-a-random-secret
APP_NAME=ONE Tracking
APP_URL=https://one-tracking.up.railway.app

# Company
COMPANY_NAME=ONE For Integrated Solutions
COMPANY_PHONE=01220733003
COMPANY_EMAIL=info@one4in.com

# Database (Railway auto-provides DATABASE_URL for Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# WhatsApp Baileys sidecar
WA_ENABLED=false
WA_SIDECAR_URL=https://one-tracking-wa.up.railway.app
WA_SIDECAR_API_KEY=ONE-Tracking-WA-Secret-2026

# Emergency migrate secret (used to run ALTER TABLEs after deploy)
EMERGENCY_MIGRATE_SECRET=ONE-Tracking-Emergency-2026

# Uploads storage — IMPORTANT for Railway.
# Railway's filesystem is ephemeral: uploaded logos/photos are wiped on every
# deploy. Add a Railway Volume mounted at /data and set the line below so
# uploads persist across deploys. Leave unset for local development.
# UPLOAD_FOLDER=/data/uploads

# Default admin
DEFAULT_ADMIN_EMAIL=admin@one4in.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@2026
DEFAULT_ADMIN_NAME=Ehab Mohamed
